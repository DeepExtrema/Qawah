# Copy this file to frontend/.env.local if your API is not on :5001.
# frontend/.env.local is git-ignored and must never be committed.
#
# This variable is usually not needed at all:
#   local development  defaults to http://localhost:5001
#   production         defaults to the empty string, meaning same-origin.
#                      On Netlify the Express API is proxied at /api on the
#                      site's own domain, so relative requests are correct.
#
# Set it only when the API lives on a different host than the frontend.
# NEXT_PUBLIC_ means the value is inlined into the client bundle at build time,
# so it is public by definition. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:5001
