# Copy this file to frontend/.env.local and adjust if your API is not on :5001.
# frontend/.env.local is git-ignored and must never be committed.

# Origin of the Express API. NEXT_PUBLIC_ is required so the value is available
# in client components; it is inlined at build time, so rebuild after changing.
# Safe to expose — it is a public URL, not a secret.
NEXT_PUBLIC_API_URL=http://localhost:5001
