# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# --- Required -------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or a local mongod).
MONGO_URI=mongodb://127.0.0.1:27017/qahwa

# Secret used to sign JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# --- Optional (sensible defaults shown) -----------------------------------

# Port the API listens on.
PORT=5001

# Origin allowed through CORS (the Next.js app).
CLIENT_ORIGIN=http://localhost:3000

# Public origin of this API. Uploaded product images are stored as absolute
# URLs against this value, so set it to the deployed host in production.
PUBLIC_API_URL=http://localhost:5001

# Stripe test-mode secret key (optional).
# Leave blank to use the built-in sandbox payment gateway, which is the
# default flow. Setting it switches checkout to Stripe PaymentIntents.
# Use a test key only; it always starts with sk_test_.
STRIPE_SECRET_KEY=
