# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.
#
# For a Netlify deployment these are set under
# Site configuration > Environment variables instead of in a file.

# --- Required -------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or a local mongod).
# Deploying to Netlify requires Atlas, not a local database, and the Atlas
# Network Access list must allow access from anywhere (0.0.0.0/0) because
# serverless functions do not have a fixed outbound IP.
MONGO_URI=mongodb://127.0.0.1:27017/qahwa

# Secret used to sign JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# --- Optional (sensible defaults shown) -----------------------------------

# Port the API listens on locally. Not used on Netlify, which has no port.
PORT=5001

# Origin allowed through CORS (the Next.js app).
# On Netlify the API is served from the same domain as the site, so requests
# are same-origin and CORS does not apply; this defaults to the Netlify site
# URL automatically and normally needs no value there.
CLIENT_ORIGIN=http://localhost:3000

# Public origin of this API, used to build absolute image URLs.
# On Netlify this defaults to the site's own URL automatically, so leave it
# unset there unless the API is hosted somewhere else.
PUBLIC_API_URL=http://localhost:5001

# Stripe test-mode secret key (optional).
# Leave blank to use the built-in sandbox payment gateway, which is the
# default flow. Setting it switches checkout to Stripe PaymentIntents.
# Use a test key only; it always starts with sk_test_.
STRIPE_SECRET_KEY=
